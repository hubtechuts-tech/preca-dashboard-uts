# ===================================
# Preca Environment Configuration
# ===================================
# Complete environment variables reference for all environments
# For production deployment with Coolify, see docs/COOLIFY_DEPLOYMENT_GUIDE.md

# -----------------------------
# Application Settings
# -----------------------------
NODE_ENV=development
# Production: production | Development: development | Testing: test

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://yourdomain.com | Development: http://localhost:3000

APP_PORT=3000
# Port the application listens on (default: 3000)

NEXT_PUBLIC_SERVER_ACTIONS_ALLOWED_ORIGINS=http://localhost:3000,127.0.0.1:3000
# Production: https://yourdomain.com | Development: http://localhost:3000,127.0.0.1:3000

# -----------------------------
# Database (PostgreSQL)
# -----------------------------
DB_HOST=localhost
# Production (Coolify): preca-db | Development: localhost

DB_PORT=5432
DB_USER=preca_dev
# Production: preca_user | Development: preca_dev

DB_PASSWORD=preca_dev_password
# Production: Use strong random password (generate with: openssl rand -base64 32)

DB_NAME=preca_dev
# Production: preca_production | Development: preca_dev

# Full connection string (used by the app)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# Production example: postgresql://preca_user:SecurePass123@preca-db:5432/preca_production

# -----------------------------
# Authentication & Security
# -----------------------------
# CRITICAL: Generate strong secrets for production using: ./scripts/generate-secrets.sh
SESSION_SECRET=change_this_in_production_use_random_string
# Production: Generate with ./scripts/generate-secrets.sh (64 chars minimum)
# Example: openssl rand -base64 48

JWT_SECRET=your_jwt_secret_key
# Production: Generate with ./scripts/generate-secrets.sh (64 chars minimum)
# Example: openssl rand -base64 48
# Used for signing and verifying JWT session tokens

# Session expiration (in seconds)
SESSION_MAX_AGE=86400
# 86400 = 24 hours | 604800 = 7 days

# Password hashing cost (bcrypt)
BCRYPT_COST=12
# Higher = more secure but slower (10-12 recommended for production)

# -----------------------------
# Stripe Payment Integration
# -----------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Development: sk_test_xxx | Production: sk_live_xxx

STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Development: pk_test_xxx | Production: pk_live_xxx

# Webhook secret (from Stripe CLI or Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Get from Stripe Dashboard > Webhooks after creating endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe

# Payment redirect URLs
STRIPE_SUCCESS_URL=${NEXT_PUBLIC_APP_URL}/payment/success
STRIPE_CANCEL_URL=${NEXT_PUBLIC_APP_URL}/payment/cancel

# -----------------------------
# Email Service
# -----------------------------
# Options: 'console' (dev), 'resend' (production)
EMAIL_PROVIDER=console
# Production: resend | Development: console

# Resend (recommended for production)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@preca.mx
# Must be a verified domain in Resend dashboard

# SendGrid (alternative - not currently implemented)
SENDGRID_API_KEY=SG.xxx

# -----------------------------
# Wee Trust Authorization Document Signing
# -----------------------------
# Get credentials from:
# - Sandbox: https://sandbox.weetrust.com.mx
# - Production: https://app.weetrust.mx
# Go to Profile > API Credentials

WEETRUST_USER_ID=
# Your Wee Trust user ID

WEETRUST_API_KEY=
# Your Wee Trust API key

WEETRUST_BASE_URL=https://api-sandbox.weetrust.com.mx/
# Sandbox: https://api-sandbox.weetrust.com.mx/
# Production: https://api.weetrust.mx/

# Path to authorization document template PDF (Carta de Autorización for Buró de Crédito)
AUTHORIZATION_DOCUMENT_PATH=./public/documents/carta_autorizacion.pdf

# -----------------------------
# File Storage (Cloudflare R2)
# -----------------------------
# Cloudflare R2 provides S3-compatible object storage with zero egress fees
# Setup Guide:
# 1. Go to Cloudflare Dashboard > R2
# 2. Create a bucket (e.g., preca-files)
# 3. Create API token: Manage R2 API Tokens > Create API Token
# 4. Copy the Access Key ID and Secret Access Key

# Cloudflare R2 Endpoint
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Format: https://[account-id].r2.cloudflarestorage.com
# Find in: R2 > Manage R2 API Tokens > Create API Token

# R2 Access Keys (from API Token creation)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# Bucket name (create in R2 Dashboard)
R2_BUCKET=preca-files
# IMPORTANT: Keep bucket private (default)

# Optional: R2 Account ID (for custom domain support)
R2_ACCOUNT_ID=your_cloudflare_account_id
# Find in: Cloudflare Dashboard > R2 > Overview

# Local storage fallback (for development without R2)
UPLOAD_DIR=./uploads

# -----------------------------
# CORS Configuration
# -----------------------------
# Allowed origins for API access (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
# Production example: https://yourdomain.com,https://n8n.yourdomain.com
# Include your n8n instance URL if using external n8n

# -----------------------------
# Rate Limiting
# -----------------------------
RATE_LIMIT_DURATION_MS=60000
# Duration in milliseconds (60000ms = 1 minute)

RATE_LIMIT_MAX_REQUESTS=100
# Max requests allowed per IP within the duration
# Production: 100-200 | Development: 1000

# -----------------------------
# Feature Flags
# -----------------------------
ENABLE_WEETRUST_VERIFICATION=false
# Enable biometric verification (optional feature, currently deferred)

ENABLE_EMAIL_NOTIFICATIONS=true
# Enable/disable email sending (set to false for testing)

ENABLE_STRIPE_PAYMENTS=true
# Enable/disable payment processing (set to false for testing)

# -----------------------------
# Monitoring & Logging
# -----------------------------
LOG_LEVEL=info
# Options: error, warn, info, debug, trace

ENABLE_REQUEST_LOGGING=true
# Log all HTTP requests (disable in production for performance)

# Sentry Error Tracking (optional but recommended for production)
SENTRY_DSN=
# Get from: https://sentry.io > Create Project > Copy DSN
# Example: https://xxxxx@sentry.io/xxxxx

# -----------------------------
# Backup Configuration (Production)
# -----------------------------
BACKUP_RETENTION_DAYS=7
# Number of days to keep database backups (used by backup script)

# -----------------------------
# pgAdmin (Development Only)
# -----------------------------
PGADMIN_EMAIL=admin@preca.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
# Access pgAdmin at http://localhost:5050

# -----------------------------
# Development Tools
# -----------------------------
NEXT_TELEMETRY_DISABLED=1
# Disable Next.js telemetry data collection

# -----------------------------
# Production Deployment Checklist
# -----------------------------
# Before deploying to production, ensure you have:
# [ ] Generated strong SESSION_SECRET and JWT_SECRET (./scripts/generate-secrets.sh)
# [ ] Configured Stripe LIVE keys (sk_live_, pk_live_)
# [ ] Set up Stripe webhook endpoint
# [ ] Configured Resend API key and verified domain
# [ ] Set up Wee Trust PRODUCTION credentials
# [ ] Created Supabase bucket (preca-reports, private)
# [ ] Configured ALLOWED_ORIGINS with production domains
# [ ] Set NODE_ENV=production
# [ ] Updated NEXT_PUBLIC_APP_URL to production domain
# [ ] Changed default admin password after first login
#
# See docs/COOLIFY_DEPLOYMENT_GUIDE.md for complete deployment instructions
